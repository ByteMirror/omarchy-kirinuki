#!/bin/bash

# Take a screenshot with Omarchy's capture flow, hold it in a scratch dir, and
# offer it in the preview panel.
#
# Nothing lands in the screenshots folder on its own: the capture stages in
# $XDG_RUNTIME_DIR and only reaches the screenshots folder when Save is
# pressed in the preview (see the plugin's actions.sh). A shot the user
# ignores simply ages out of the scratch dir.
#
# Selection and capture are slurp + grim, straight into the staging dir, then
# the file is handed to the panel. (Omarchy 4.5's omarchy-capture-screenshot
# is omasnap with its own overlay and toast, so it is not used.)
#
# Usage: capture [smart|region|windows|fullscreen]
#
# Environment:
#   KIRINUKI_JPEG=1         transcode captures to JPEG (needs magick)
#   KIRINUKI_JPEG_QUALITY   JPEG quality, default 92
#   KIRINUKI_STAGING_DIR    where captures wait, default
#                                     $XDG_RUNTIME_DIR/kirinuki
#   KIRINUKI_KEEP_MINUTES   age at which an unsaved capture is
#                                     dropped, default 1440
#
# Omarchy's own OMARCHY_SCREENSHOT_DIR and OMARCHY_SCREENSHOT_EDITOR are
# honoured as-is; this plugin does not shadow them.

set -uo pipefail
umask 077 # staged captures are private, whichever tool writes them

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd) || exit 1
source "$here/../lib/guard.sh" || exit 1

MODE="${1:-smart}"
case "$MODE" in smart | region | windows | fullscreen) ;; *) exit 2 ;; esac

QUALITY="${KIRINUKI_JPEG_QUALITY:-92}"
KEEP_MINUTES="${KIRINUKI_KEEP_MINUTES:-1440}"

# Staged captures are private: the dir is created 0700 and refused outright if
# it already exists as somebody else's, which is the case that matters when
# $XDG_RUNTIME_DIR is missing and the fallback lands in a shared /tmp.
STAGING=$(kirinuki_stage_ensure) || exit 1

# Unsaved captures are disposable; drop yesterday's so the scratch dir cannot
# grow without bound. A pinned shot older than this loses its image, but pins
# do not survive a shell restart anyway.
find "$STAGING" -maxdepth 1 -type f -mmin "+$KEEP_MINUTES" -delete 2>/dev/null

# Window boxes on every monitor's visible workspace, in slurp's "x,y wxh"
# format, so a click picks a window and a drag still draws a region.
window_boxes() {
  local active
  active=$(hyprctl monitors -j | jq -r '[.[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0)) | join(",")')
  # KIRINUKI_IGNORE_CLASSES: space-separated window classes never offered as
  # boxes, e.g. an app's invisible always-mapped overlay window.
  hyprctl clients -j | jq -r --arg ws "$active" --arg ignore "${KIRINUKI_IGNORE_CLASSES:-}" '
    ($ws | split(",") | map(tonumber)) as $ids
    | ($ignore | split(" ") | map(select(. != ""))) as $skip
    | .[] | select(.mapped and (.hidden | not) and (.workspace.id as $w | $ids | index($w)))
    | select(.class as $c | $skip | index($c) | not)
    | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

# Kirinuki does its own selection with slurp + grim. Omarchy 4.5 moved
# omarchy-capture-screenshot onto omasnap, whose overlay replaces this
# plugin's flow -- so Omarchy's capture command is no longer used at all.
# The hotkey toggles: pressed again mid-selection, it cancels.
if pkill -x slurp 2>/dev/null; then exit 0; fi

monitors=$(hyprctl monitors -j)

# Freeze before selecting. slurp's overlay takes the pointer, so the app
# underneath gets a pointer-leave and drops its hover state (tooltips, menus,
# :hover styles) before grim could see it. So every output is grabbed first,
# hyprpicker holds that frozen picture on screen while the user selects, and
# the selection is cropped out of the grab.
#
# The grabs are raw PPM: PNG-compressing a 4K frame costs grim ~0.8 s, all of
# it before slurp can appear; PPM takes ~60 ms and holds the same pixels.
# The crop needs ImageMagick, which is optional: without it there is nothing
# to crop with, so selection runs live as before (and hover is lost).
picker=""
frozen=""
if [[ $MODE != fullscreen ]] && command -v magick >/dev/null 2>&1; then
  frozen=$(mktemp -d "$STAGING/.frozen.XXXXXX") || exit 1
  trap '[[ -n $picker ]] && kill "$picker" 2>/dev/null; rm -rf -- "$frozen"' EXIT
  for out in $(jq -r '.[].name' <<<"$monitors"); do
    grim -t ppm -o "$out" "$frozen/$out.ppm" &
  done
  wait
  if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z -d -q >/dev/null 2>&1 &
    picker=$!
    # slurp must map after the freeze or the freeze covers it. Wait for the
    # layer (~60 ms), capped at 0.5 s so a hyprpicker that never maps cannot
    # hold up the selection.
    for _ in {1..50}; do
      hyprctl layers -j | jq -e '[.. | .namespace? | select(. == "hyprpicker")] | length > 0' >/dev/null && break
      sleep 0.01
    done
  fi
fi

case "$MODE" in
  fullscreen)
    output=$(jq -r '.[] | select(.focused) | .name' <<<"$monitors")
    geom=""
    ;;
  region) geom=$(slurp 2>/dev/null) ;;
  windows) geom=$(window_boxes | slurp -r 2>/dev/null) ;;
  smart) geom=$(window_boxes | slurp -o 2>/dev/null) ;;
esac

if [[ -n $picker ]]; then kill "$picker" 2>/dev/null; picker=""; fi

# slurp exits non-zero when the selection is cancelled: a normal no-op.
if [[ $MODE != fullscreen && -z $geom ]]; then exit 0; fi

# Logical slurp geometry -> "<output> <physical crop>" on the one unrotated
# output that holds it, or nothing.
frozen_crop() {
  [[ $1 =~ ^(-?[0-9]+),(-?[0-9]+)\ ([0-9]+)x([0-9]+)$ ]] || return 1
  jq -r --argjson x "${BASH_REMATCH[1]}" --argjson y "${BASH_REMATCH[2]}" \
    --argjson w "${BASH_REMATCH[3]}" --argjson h "${BASH_REMATCH[4]}" '
    [.[] | select(.transform == 0)
      | select($x >= .x and $y >= .y
          and $x + $w <= .x + .width / .scale + 1
          and $y + $h <= .y + .height / .scale + 1)
      | "\(.name) \($w * .scale | round)x\($h * .scale | round)+\(($x - .x) * .scale | round)+\(($y - .y) * .scale | round)"
    ] | first // empty' <<<"$monitors"
}

want_jpg=0
[[ ${KIRINUKI_JPEG:-0} == 1 ]] && command -v magick >/dev/null 2>&1 && want_jpg=1

shot="$STAGING/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

# Writes $shot from the frozen grab; fails when there is none to crop from.
# In JPEG mode the crop is encoded straight to JPEG: going through PNG first
# costs up to a second on a full 4K frame for the same pixels.
crop_frozen() {
  local out crop
  [[ -n $frozen ]] || return 1
  read -r out crop < <(frozen_crop "$geom") && [[ -s $frozen/$out.ppm ]] || return 1
  if ((want_jpg)); then
    kirinuki_magick "ppm:$frozen/$out.ppm" -crop "$crop" +repage -background white \
      -flatten -quality "$QUALITY" "jpg:${shot%.png}.jpg" 2>/dev/null || return 1
    shot="${shot%.png}.jpg"
  else
    kirinuki_magick "ppm:$frozen/$out.ppm" -crop "$crop" +repage "png:$shot" 2>/dev/null
  fi
}

if [[ $MODE == fullscreen ]]; then
  grim -o "$output" "$shot" || exit 1
elif crop_frozen; then
  :
else
  # ponytail: a selection spanning two monitors (or on a rotated one), or any
  # selection without ImageMagick, is shot live and loses hover; stitch the
  # frozen grabs if the two-monitor case ever matters.
  grim -g "$geom" "$shot" || exit 1
fi

# Empty output means the selection was cancelled, or a running slurp was
# dismissed -- both are a normal no-op, not a failure.
[[ -n $shot ]] || exit 0

# Everything downstream -- the panel, the editor, OCR -- trusts what this
# prints, so the capture goes through the same guard as any other path before
# it gets that standing.
shot=$(kirinuki_safe_image "$shot") || exit 0

# Opt-in JPEG. Off by default: it costs an ImageMagick dependency and changes
# the format of every screenshot, which is a decision for the user rather than
# for the preview panel. JPEG has no alpha channel, so the image is flattened
# onto white -- otherwise transparency comes out black. Keeping the PNG on a
# failed conversion beats losing the capture, and every step downstream
# handles either format.
#
# The transcode runs beneath bin/open and reads the capture from fd 3, the
# same discipline as every other read and write in this plugin.
if ((want_jpg)) && [[ $shot == *.png ]]; then
  jpg="${shot%.png}.jpg"
  if kirinuki_with_fd "$shot" kirinuki_transcode_jpg "$jpg" "$QUALITY"; then
    rm -f -- "$shot"
    shot="$jpg"
  fi
fi

# The panel is where Copy / Save / Edit / OCR / Pin live. Without it the
# capture would sit in a scratch dir the user never sees, so fall back to the
# stock behaviour: keep the file and say where it went. Save and copy both
# happen beneath one bin/open, from the one descriptor, and only then is the
# staged copy dropped.
if ! "$here/summon" "$shot"; then
  if dest=$(kirinuki_with_fd "$shot" kirinuki_promote "$(basename "$shot")" "$(kirinuki_screenshot_dir)"); then
    rm -f -- "$shot"
  else
    dest="$shot"
  fi

  omarchy-notification-send "Screenshot saved to clipboard and file" "$(basename "$dest")" \
    --image "$dest" \
    --exec "$(printf '%q %q' "$here/edit" "$dest")" >/dev/null 2>&1 || true

  shot="$dest"
fi

# Printed last so it names where the capture actually is, staged or saved.
echo "$shot"
