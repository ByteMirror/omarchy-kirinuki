#!/bin/bash

# Take a screenshot with Omarchy's capture flow, hold it in a scratch dir, and
# offer it in the preview panel.
#
# Nothing lands in the screenshots folder on its own: the capture stages in
# $XDG_RUNTIME_DIR and only reaches the screenshots folder when Save is
# pressed in the preview (see the plugin's actions.sh). A shot the user
# ignores simply ages out of the scratch dir.
#
# Selection and capture are slurp + grim, straight into the staging dir, then
# the file is handed to the panel. (Omarchy 4.5's omarchy-capture-screenshot
# is omasnap with its own overlay and toast, so it is not used.)
#
# Usage: capture [smart|region|windows|fullscreen]
#
# Environment:
#   KIRINUKI_JPEG=1         transcode captures to JPEG (needs magick)
#   KIRINUKI_JPEG_QUALITY   JPEG quality, default 92
#   KIRINUKI_STAGING_DIR    where captures wait, default
#                                     $XDG_RUNTIME_DIR/kirinuki
#   KIRINUKI_KEEP_MINUTES   age at which an unsaved capture is
#                                     dropped, default 1440
#   KIRINUKI_WINDOW_FRAME=0 shoot a picked window bare, without the
#                                     wallpaper backdrop (needs magick)
#
# Omarchy's own OMARCHY_SCREENSHOT_DIR and OMARCHY_SCREENSHOT_EDITOR are
# honoured as-is; this plugin does not shadow them.

set -uo pipefail
umask 077 # staged captures are private, whichever tool writes them

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd) || exit 1
source "$here/../lib/guard.sh" || exit 1

MODE="${1:-smart}"
case "$MODE" in smart | region | windows | fullscreen) ;; *) exit 2 ;; esac

QUALITY="${KIRINUKI_JPEG_QUALITY:-92}"
KEEP_MINUTES="${KIRINUKI_KEEP_MINUTES:-1440}"

# Staged captures are private: the dir is created 0700 and refused outright if
# it already exists as somebody else's, which is the case that matters when
# $XDG_RUNTIME_DIR is missing and the fallback lands in a shared /tmp.
STAGING=$(kirinuki_stage_ensure) || exit 1

# Unsaved captures are disposable; drop yesterday's so the scratch dir cannot
# grow without bound. A pinned shot older than this loses its image, but pins
# do not survive a shell restart anyway.
find "$STAGING" -maxdepth 1 -type f -mmin "+$KEEP_MINUTES" -delete 2>/dev/null

# Window boxes on every monitor's visible workspace, in slurp's "x,y wxh"
# format, so a click picks a window and a drag still draws a region.
window_boxes() {
  local active
  active=$(hyprctl monitors -j | jq -r '[.[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0)) | join(",")')
  # KIRINUKI_IGNORE_CLASSES: space-separated window classes never offered as
  # boxes, e.g. an app's invisible always-mapped overlay window.
  hyprctl clients -j | jq -r --arg ws "$active" --arg ignore "${KIRINUKI_IGNORE_CLASSES:-}" '
    ($ws | split(",") | map(tonumber)) as $ids
    | ($ignore | split(" ") | map(select(. != ""))) as $skip
    | .[] | select(.mapped and (.hidden | not) and (.workspace.id as $w | $ids | index($w)))
    | select(.class as $c | $skip | index($c) | not)
    | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

# Kirinuki does its own selection with slurp + grim. Omarchy 4.5 moved
# omarchy-capture-screenshot onto omasnap, whose overlay replaces this
# plugin's flow -- so Omarchy's capture command is no longer used at all.
# The hotkey toggles: pressed again mid-selection, it cancels. pidof, not
# pkill: pkill reads every process's cmdline (~50 ms on a busy desktop),
# pidof only their names (~15 ms).
if slurps=$(pidof slurp); then
  # shellcheck disable=SC2086 # one pid per word
  kill $slurps 2>/dev/null
  exit 0
fi

monitors=$(hyprctl monitors -j)

# Freeze before selecting. slurp's overlay takes the pointer, so the app
# underneath gets a pointer-leave and drops its hover state (tooltips, menus,
# :hover styles) before grim could see it. So every output is grabbed first,
# the panel (or hyprpicker) holds that frozen picture on screen while the user selects, and
# the selection is cropped out of the grab.
#
# The grabs are raw PPM: PNG-compressing a 4K frame costs grim ~0.8 s, all of
# it before slurp can appear; PPM takes ~60 ms and holds the same pixels.
# The crop needs ImageMagick, which is optional: without it there is nothing
# to crop with, so selection runs live as before (and hover is lost).
picker=""
frozen=""
shell_frozen=0
# Wait (capped at 0.5 s) until <namespace> has a layer on every output, so
# slurp maps after the freeze -- otherwise the freeze covers it.
await_layer() {
  local n
  n=$(jq length <<<"$monitors")
  for _ in {1..50}; do
    (($(hyprctl layers -j | jq --arg ns "$1" '[.. | .namespace? | select(. == $ns)] | length') >= n)) && return 0
    sleep 0.01
  done
  return 1
}

# Background window frames (see below): box -> "<pid> <file>".
declare -A spec=()
# Kills every background frame job except <keep> ("<pid> <file>", optional).
# The job's children are signalled too: kirinuki_magick's timeout puts itself
# in a process group of its own, so only a signal to it reaches magick. They
# are read from /proc directly -- pkill -P scans every process and costs
# ~50 ms a job, right between the click and the preview.
spec_kill() {
  local job pid kids
  for job in "${spec[@]}"; do
    [[ $job == "${1:-}" ]] && continue
    pid=${job%% *} kids=""
    read -r kids 2>/dev/null <"/proc/$pid/task/$pid/children"
    # shellcheck disable=SC2086 # one pid per word
    kill $kids "$pid" 2>/dev/null
  done
}

if [[ $MODE != fullscreen ]] && command -v magick >/dev/null 2>&1; then
  frozen=$(mktemp -d "$STAGING/.frozen.XXXXXX") || exit 1
  trap 'spec_kill; [[ -n $picker ]] && kill "$picker" 2>/dev/null; ((shell_frozen)) && omarchy-shell kirinuki unfreeze >/dev/null 2>&1; rm -rf -- "$frozen"' EXIT
  for out in $(jq -r '.[].name' <<<"$monitors"); do
    grim -t ppm -o "$out" "$frozen/$out.ppm" &
  done
  wait
  # The shell's freeze layer is one screencopy still per output. hyprpicker
  # -r is the fallback when the shell is not running, but it repaints its
  # whole frame continuously, which makes the slurp drag stutter on 4K.
  if [[ $(OMARCHY_SHELL_IPC_TIMEOUT=1 omarchy-shell kirinuki freeze 2>/dev/null) == ok ]]; then
    shell_frozen=1
    await_layer kirinuki-freeze
  elif command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z -d -q >/dev/null 2>&1 &
    picker=$!
    await_layer hyprpicker
  fi
fi

# Logical slurp geometry -> "<output> <physical crop>" on the one unrotated
# output that holds it, or nothing.
frozen_crop() {
  [[ $1 =~ ^(-?[0-9]+),(-?[0-9]+)\ ([0-9]+)x([0-9]+)$ ]] || return 1
  jq -r --argjson x "${BASH_REMATCH[1]}" --argjson y "${BASH_REMATCH[2]}" \
    --argjson w "${BASH_REMATCH[3]}" --argjson h "${BASH_REMATCH[4]}" '
    [.[] | select(.transform == 0)
      | select($x >= .x and $y >= .y
          and $x + $w <= .x + .width / .scale + 1
          and $y + $h <= .y + .height / .scale + 1)
      | "\(.name) \($w * .scale | round)x\($h * .scale | round)+\(($x - .x) * .scale | round)+\(($y - .y) * .scale | round)"
    ] | first // empty' <<<"$monitors"
}

want_jpg=0
[[ ${KIRINUKI_JPEG:-0} == 1 ]] && command -v magick >/dev/null 2>&1 && want_jpg=1
fmt=png
((want_jpg)) && fmt=jpg

# Writes the window image <src> (any magick read spec, e.g. a crop of the
# frozen grab) of window box <box> to <out> as <png|jpg>, framed on the
# current Omarchy wallpaper -- one encode, since encoding the wallpaper is most
# of the cost. The window keeps Hyprland's corner radius (scaled to the grab's
# pixels); the corners in the grab show whatever was behind the window, so
# they are cut away rather than inherited. Touches nothing but <out>, so it
# can run in the background.
frame_render() {
  local box="$1" src="$2" out_fmt="$3" out="$4" bg w h scale r pad cw ch q
  local -a enc mask corners=()
  bg=$(readlink -f -- "$HOME/.local/state/omarchy/current/background") && [[ -f $bg ]] || return 1
  read -r w h <<<"$(kirinuki_magick "$src" -format '%w %h' info:)"
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 1
  # Scale of the output holding the window: grab pixels per logical pixel.
  scale=$(jq -r --argjson x "${box%%,*}" '[.[] | select($x >= .x and $x < .x + .width / .scale)][0].scale // 1' <<<"$monitors")
  r=$(hyprctl getoption decoration:rounding -j 2>/dev/null | jq -r ".int * $scale | round" 2>/dev/null)
  [[ $r =~ ^[0-9]+$ ]] || r=0
  # ponytail: padding is ~4.25% of the window's long side; make it a knob if
  # anyone wants Shottr's padding slider.
  pad=$(((w > h ? w : h) * 1701 / 40000))
  ((pad < 29)) && pad=29
  cw=$((w + 2 * pad)) ch=$((h + 2 * pad)) q=$((pad / 4))
  # zlib level 1: a photo backdrop compresses no better at the default level,
  # which takes twice as long (~2 s on a 4K window).
  if [[ $out_fmt == jpg ]]; then
    enc=(-quality "$QUALITY" "jpg:$out")
  else
    enc=(-define png:compression-level=1 "png:$out")
  fi
  # The window's corners are cut by four r x r composites of one quarter-disc
  # mask rather than by masking the whole window: on this Q16-HDRI build every
  # full-size pass costs ~100 ms. Gravity is pinned inside the mask because it
  # persists across operators and would move the mask's own crop.
  if ((r > 0)); then
    mask=(-gravity northwest -size "$((2 * r))x$((2 * r))" xc:none -fill black
      -draw "circle $r,$r $r,0" -alpha extract -negate -crop "${r}x${r}+0+0" +repage
      -background black -alpha shape)
    corners=(-compose DstOut
      \( "${mask[@]}" \) -gravity northwest -composite
      \( "${mask[@]}" -flop \) -gravity northeast -composite
      \( "${mask[@]}" -flip \) -gravity southwest -composite
      \( "${mask[@]}" -flip -flop \) -gravity southeast -composite)
  fi
  # The shadow is centred, not dropped: an offset makes the bottom padding
  # read heavier than the top. It is drawn and blurred at quarter size, then
  # scaled up: a blur that wide hides the resampling, and at full size it
  # costs seconds. Only its alpha is blurred; the colour is black throughout.
  kirinuki_magick "$bg" -resize "${cw}x${ch}^" -gravity center -extent "${cw}x${ch}" +repage \
    \( -size "$((cw / 4))x$((ch / 4))" xc:none -fill 'rgba(0,0,0,0.45)' \
    -draw "roundrectangle $q,$q,$(((pad + w) / 4)),$(((pad + h) / 4)),$((r / 4)),$((r / 4))" \
    -channel A -blur "0x$((q / 3 + 1))" +channel -resize "${cw}x${ch}!" \) \
    -compose over -composite \
    \( "$src" +repage -alpha set "${corners[@]}" \) \
    -gravity northwest -geometry "+$pad+$pad" -compose over -composite \
    "${enc[@]}" 2>/dev/null \
    && kirinuki_output_ok "$out"
}

boxes=""
[[ $MODE == smart || $MODE == windows ]] && boxes=$(window_boxes)

# Framing a window is ~1 s of ImageMagick on a 4K grab -- too slow to start
# after the click. The boxes and the frozen pixels are both known before slurp
# opens, so every box is framed in the background while the user is still
# choosing; by the time a window is clicked its frame is usually done. The
# jobs are niced so the selection overlay stays smooth, and killed the moment
# slurp returns anything they did not frame.
# ponytail: one job per visible window, ~1 core-second each, thrown away on a
# drawn region; cap the count if busy workspaces ever feel it.
if [[ ${KIRINUKI_WINDOW_FRAME:-1} == 1 && -n $frozen && -n $boxes ]]; then
  n=0
  while IFS= read -r box; do
    read -r out crop < <(frozen_crop "$box") && [[ -s $frozen/$out.ppm ]] || continue
    (
      renice -n 10 -p "$BASHPID" >/dev/null 2>&1
      frame_render "$box" "ppm:$frozen/$out.ppm[$crop]" "$fmt" "$frozen/spec.$n"
    ) &
    spec[$box]="$! $frozen/spec.$n"
    n=$((n + 1))
  done <<<"$boxes"
fi

case "$MODE" in
  fullscreen)
    output=$(jq -r '.[] | select(.focused) | .name' <<<"$monitors")
    geom=""
    ;;
  region) geom=$(slurp 2>/dev/null) ;;
  windows) geom=$(slurp -r <<<"$boxes" 2>/dev/null) ;;
  smart) geom=$(slurp -o <<<"$boxes" 2>/dev/null) ;;
esac

if [[ -n $picker ]]; then kill "$picker" 2>/dev/null; picker=""; fi
# The crop reads the frozen PPM, not the screen, so the freeze layer comes
# down while the capture is encoded; summon waits for it below.
unfreezing=""
if ((shell_frozen)); then
  omarchy-shell kirinuki unfreeze >/dev/null 2>&1 &
  unfreezing=$!
  shell_frozen=0
fi

# slurp exits non-zero when the selection is cancelled: a normal no-op.
if [[ $MODE != fullscreen && -z $geom ]]; then exit 0; fi

# A click on a window box (slurp hands back exactly that box) gets the
# Shottr look: rounded corners and a shadow, centred on the wallpaper. A drawn
# region never matches a box to the pixel, so it stays a plain crop.
framed=0
[[ ${KIRINUKI_WINDOW_FRAME:-1} == 1 && -n $geom && -n $boxes ]] \
  && grep -qxF -- "$geom" <<<"$boxes" && command -v magick >/dev/null 2>&1 && framed=1

# Only the clicked window's frame is still wanted; free the CPU for it.
spec_kill "$( ((framed)) && printf '%s' "${spec[$geom]:-}")"

shot="$STAGING/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

# Moves a finished frame <file> into place as the capture.
adopt_frame() {
  local dest="${shot%.*}.$fmt"
  mv -fT -- "$1" "$dest" || return 1
  [[ $dest != "$shot" ]] && rm -f -- "$shot"
  shot="$dest"
}

# The clicked window's background frame, once its job has finished cleanly.
spec_take() {
  local job="${spec[$geom]:-}"
  [[ -n $job ]] && wait "${job%% *}" && adopt_frame "${job#* }"
}

# Frames <src> into $shot synchronously. Leaves $shot alone on any failure.
frame_window() {
  local tmp
  tmp=$(mktemp -- "$STAGING/.frame.XXXXXX") || return 1
  frame_render "$geom" "$1" "$fmt" "$tmp" && adopt_frame "$tmp" && return 0
  rm -f -- "$tmp"
  return 1
}

# Writes $shot from the frozen grab; fails when there is none to crop from.
# In JPEG mode the crop is encoded straight to JPEG: going through PNG first
# costs up to a second on a full 4K frame for the same pixels.
crop_frozen() {
  local out crop
  [[ -n $frozen ]] || return 1
  read -r out crop < <(frozen_crop "$geom") && [[ -s $frozen/$out.ppm ]] || return 1
  # Read-crop straight out of the PPM: no intermediate file to encode.
  if ((framed)); then
    spec_take && return 0
    frame_window "ppm:$frozen/$out.ppm[$crop]" && return 0
  fi
  # vips first (~80 ms for a 4K-ish JPEG, where magick takes ~270 ms);
  # magick is the fallback. PNG goes out at zlib level 1 with the sub filter:
  # ~4% larger than the default level, which cost a full second.
  local cw ch cx cy
  IFS='x+' read -r cw ch cx cy <<<"$crop"
  if ((want_jpg)); then
    kirinuki_vips crop "$frozen/$out.ppm" "${shot%.png}.jpg[Q=$QUALITY]" "$cx" "$cy" "$cw" "$ch" \
      || kirinuki_magick "ppm:$frozen/$out.ppm[$crop]" -quality "$QUALITY" \
        "jpg:${shot%.png}.jpg" 2>/dev/null || return 1
    shot="${shot%.png}.jpg"
  else
    kirinuki_vips crop "$frozen/$out.ppm" "$shot[compression=1,filter=sub]" "$cx" "$cy" "$cw" "$ch" \
      || kirinuki_magick "ppm:$frozen/$out.ppm[$crop]" -define png:compression-level=1 \
        "png:$shot" 2>/dev/null
  fi
}

if [[ $MODE == fullscreen ]]; then
  # grim encodes the final format itself: ~80 ms for a 4K JPEG, where a PNG at
  # grim's default level (~0.5 s) plus a transcode after it cost ~1 s.
  if ((want_jpg)); then
    grim -t jpeg -q "$QUALITY" -o "$output" "${shot%.png}.jpg" || exit 1
    shot="${shot%.png}.jpg"
  else
    grim -l 1 -o "$output" "$shot" || exit 1
  fi
elif crop_frozen; then
  :
else
  # ponytail: a selection spanning two monitors (or on a rotated one), or any
  # selection without ImageMagick, is shot live and loses hover; stitch the
  # frozen grabs if the two-monitor case ever matters.
  grim -l 1 -g "$geom" "$shot" || exit 1
  ((framed)) && frame_window "png:$shot"
fi

# Empty output means the selection was cancelled, or a running slurp was
# dismissed -- both are a normal no-op, not a failure.
[[ -n $shot ]] || exit 0

# Everything downstream -- the panel, the editor, OCR -- trusts what this
# prints, so the capture goes through the same guard as any other path before
# it gets that standing.
shot=$(kirinuki_safe_image "$shot") || exit 0

# Opt-in JPEG. Off by default: it costs an ImageMagick dependency and changes
# the format of every screenshot, which is a decision for the user rather than
# for the preview panel. JPEG has no alpha channel, so the image is flattened
# onto white -- otherwise transparency comes out black. Keeping the PNG on a
# failed conversion beats losing the capture, and every step downstream
# handles either format.
#
# The transcode runs beneath bin/open and reads the capture from fd 3, the
# same discipline as every other read and write in this plugin.
if ((want_jpg)) && [[ $shot == *.png ]]; then
  jpg="${shot%.png}.jpg"
  if kirinuki_with_fd "$shot" kirinuki_transcode_jpg "$jpg" "$QUALITY"; then
    rm -f -- "$shot"
    shot="$jpg"
  fi
fi

# The panel is where Copy / Save / Edit / OCR / Pin live. Without it the
# capture would sit in a scratch dir the user never sees, so fall back to the
# stock behaviour: keep the file and say where it went. Save and copy both
# happen beneath one bin/open, from the one descriptor, and only then is the
# staged copy dropped.
[[ -n $unfreezing ]] && wait "$unfreezing"
if ! "$here/summon" "$shot"; then
  if dest=$(kirinuki_with_fd "$shot" kirinuki_promote "$(basename "$shot")" "$(kirinuki_screenshot_dir)"); then
    rm -f -- "$shot"
  else
    dest="$shot"
  fi

  omarchy-notification-send "Screenshot saved to clipboard and file" "$(basename "$dest")" \
    --image "$dest" \
    --exec "$(printf '%q %q' "$here/edit" "$dest")" >/dev/null 2>&1 || true

  shot="$dest"
fi

# Printed last so it names where the capture actually is, staged or saved.
echo "$shot"
