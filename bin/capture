#!/bin/bash

# Take a screenshot with Omarchy's capture flow, hold it in a scratch dir, and
# offer it in the preview panel.
#
# Nothing lands in the screenshots folder on its own: the capture stages in
# $XDG_RUNTIME_DIR and only reaches the screenshots folder when Save is
# pressed in the preview (see the plugin's actions.sh). A shot the user
# ignores simply ages out of the scratch dir.
#
# omarchy-capture-screenshot always writes PNG into its output directory, so
# it is wrapped rather than edited: capture with `save` (skipping the editor
# and notification) into a redirected output dir, then hand the file to the
# panel.
#
# Usage: capture [smart|region|windows|fullscreen]
#
# Environment:
#   KIRINUKI_JPEG=1         transcode captures to JPEG (needs magick)
#   KIRINUKI_JPEG_QUALITY   JPEG quality, default 92
#   KIRINUKI_STAGING_DIR    where captures wait, default
#                                     $XDG_RUNTIME_DIR/kirinuki
#   KIRINUKI_KEEP_MINUTES   age at which an unsaved capture is
#                                     dropped, default 1440
#
# Omarchy's own OMARCHY_SCREENSHOT_DIR and OMARCHY_SCREENSHOT_EDITOR are
# honoured as-is; this plugin does not shadow them.

set -uo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd) || exit 1
source "$here/../lib/guard.sh" || exit 1

MODE="${1:-smart}"
case "$MODE" in smart | region | windows | fullscreen) ;; *) exit 2 ;; esac

QUALITY="${KIRINUKI_JPEG_QUALITY:-92}"
KEEP_MINUTES="${KIRINUKI_KEEP_MINUTES:-1440}"

# Staged captures are private: the dir is created 0700 and refused outright if
# it already exists as somebody else's, which is the case that matters when
# $XDG_RUNTIME_DIR is missing and the fallback lands in a shared /tmp.
STAGING=$(kirinuki_stage_ensure) || exit 1

# Unsaved captures are disposable; drop yesterday's so the scratch dir cannot
# grow without bound. A pinned shot older than this loses its image, but pins
# do not survive a shell restart anyway.
find "$STAGING" -maxdepth 1 -type f -mmin "+$KEEP_MINUTES" -delete 2>/dev/null

# `save` prints the saved path; take the last line in case anything else
# (e.g. the "created screenshot directory" notice) is written first.
shot=$(OMARCHY_SCREENSHOT_DIR="$STAGING" omarchy-capture-screenshot "$MODE" save | tail -n 1) || exit 1

# Empty output means the selection was cancelled, or a running slurp was
# dismissed -- both are a normal no-op, not a failure.
[[ -n $shot ]] || exit 0

# Everything downstream -- the panel, the editor, OCR -- trusts what this
# prints, so the capture goes through the same guard as any other path before
# it gets that standing.
shot=$(kirinuki_safe_image "$shot") || exit 0

# Opt-in JPEG. Off by default: it costs an ImageMagick dependency and changes
# the format of every screenshot, which is a decision for the user rather than
# for the preview panel. JPEG has no alpha channel, so the image is flattened
# onto white -- otherwise transparency comes out black. Keeping the PNG on a
# failed conversion beats losing the capture, and every step downstream
# handles either format.
#
# The transcode runs beneath bin/open and reads the capture from fd 3, the
# same discipline as every other read and write in this plugin.
if [[ ${KIRINUKI_JPEG:-0} == 1 ]] && command -v magick >/dev/null 2>&1; then
  jpg="${shot%.png}.jpg"
  if kirinuki_with_fd "$shot" kirinuki_transcode_jpg "$jpg" "$QUALITY"; then
    rm -f -- "$shot"
    shot="$jpg"
  fi
fi

# The panel is where Copy / Save / Edit / OCR / Pin live. Without it the
# capture would sit in a scratch dir the user never sees, so fall back to the
# stock behaviour: keep the file and say where it went. Save and copy both
# happen beneath one bin/open, from the one descriptor, and only then is the
# staged copy dropped.
if ! "$here/summon" "$shot"; then
  if dest=$(kirinuki_with_fd "$shot" kirinuki_promote "$(basename "$shot")" "$(kirinuki_screenshot_dir)"); then
    rm -f -- "$shot"
  else
    dest="$shot"
  fi

  omarchy-notification-send "Screenshot saved to clipboard and file" "$(basename "$dest")" \
    --image "$dest" \
    --exec "$(printf '%q %q' "$here/edit" "$dest")" >/dev/null 2>&1 || true

  shot="$dest"
fi

# Printed last so it names where the capture actually is, staged or saved.
echo "$shot"
