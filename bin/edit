#!/bin/bash

# Annotate a staged capture, then bring the preview panel back.
#
# An edited capture is still only staged, so the panel has to return: without
# it there is no way left to save, copy, or pin what was just annotated.
#
# The editor never sees the staged file. The capture is opened once, by
# bin/open, and held on fd 3 for the whole session; the editor works on a
# private scratch copy, and every save is folded back into the held inode by
# writing through the descriptor. So what gets edited is what was verified, and what
# gets overwritten is that same object -- not whatever the staged name has
# been pointed at since.
#
# With Omarchy's own editor the fold-back runs on every save rather than only
# at exit, so the file always matches what was last saved; Tensaku's own
# notifications are suppressed because they would report the scratch path in
# /tmp, which looks like the screenshot went missing. JPEG needs the
# round-trip anyway: Tensaku reads JPEG fine but can only *write* PNG, so its
# output is transcoded on the way back and the capture stays in one format.
# A custom OMARCHY_SCREENSHOT_EDITOR is handed the scratch copy to edit in
# place and folded back once it exits.
#
# Usage: edit <file>
#        edit --copy-helper   (internal: Tensaku's --copy-command, so the
#        clipboard gets an explicit image/png offer and copying still notifies)

set -uo pipefail

QUALITY="${KIRINUKI_JPEG_QUALITY:-92}"
# Omarchy 4.5 dropped Tensaku for omasnap's own editor.
if [[ -n ${OMARCHY_SCREENSHOT_EDITOR:-} ]]; then
  EDITOR_CMD=$OMARCHY_SCREENSHOT_EDITOR
elif command -v tensaku >/dev/null 2>&1; then
  EDITOR_CMD=tensaku-edit
else
  EDITOR_CMD=omasnap
fi

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd) || exit 1
source "$here/../lib/guard.sh" || exit 1

# Tensaku pipes the PNG it copies to this command on stdin. The explicit
# --type matters: wl-copy advertises only the type it is given, most apps ask
# for image/png when pasting, and Omarchy's clipboard history watches
# `text` and `image/png` alone.
if [[ ${1:-} == --copy-helper ]]; then
  # Staged through a private scratch file rather than straight into wl-copy, so
  # what reaches the clipboard is bounded by the same ceiling as everything
  # else here instead of by whatever the editor decides to write.
  clipdir=$(mktemp -d) || exit 1
  trap 'rm -rf "$clipdir"' EXIT
  head -c "$((KIRINUKI_MAX_BYTES + 1))" >"$clipdir/clip.png"
  kirinuki_output_ok "$clipdir/clip.png" || exit 1
  wl-copy --type image/png <"$clipdir/clip.png" || exit 1
  omarchy-notification-send "Screenshot copied to clipboard" -t 2000 >/dev/null 2>&1 || true
  exit 0
fi

# Opening an editor on an arbitrary path is exactly what the guard is for:
# only a staged or saved capture of ours, within the decode limits, gets one.
kirinuki_hold "${1:-}" "$0" "$@" || exit 1
file=$KIRINUKI_FILE
fd=$KIRINUKI_FD
fmt=$(kirinuki_format "$file") || exit 1

if [[ $fmt == jpg ]] && ! command -v magick >/dev/null 2>&1; then
  omarchy-notification-send "Cannot edit JPEG capture" \
    "ImageMagick (magick) is not installed" >/dev/null 2>&1 || true
  exit 1
fi

tmpdir=$(mktemp -d) || exit 1
trap 'rm -rf "$tmpdir"' EXIT
base=$(basename "${file%.*}")
src="$tmpdir/$base.png"   # what the editor is shown
png="$tmpdir/$base.out.png" # what Tensaku writes
self=$(readlink -f -- "$0")

# The editor's copy, from the descriptor. A JPEG is flattened onto white on
# the way in, so the editor works on the same pixels the fold-back produces.
if [[ $fmt == png ]]; then
  cat -- "/dev/fd/$fd" >"$src" || exit 1
else
  kirinuki_magick "jpg:/dev/fd/$fd" -background white -flatten "png:$src" 2>/dev/null || exit 1
fi
kirinuki_output_ok "$src" || exit 1

# Fold <edited png> back into the held capture. The scratch PNG is the
# editor's output, not a capture, so it is checked on its own terms: inside
# this run's private mktemp dir, within the size ceiling, and converted under
# the same bounded ImageMagick limits as everything else. JPEG has no alpha
# channel; flatten onto white so transparency in the annotations does not
# come out black. A half-written PNG just fails and gets retried on the next
# poll. The write goes to /dev/fd/3, which truncates and rewrites the inode
# that was verified at open -- the staged name is never touched again.
fold_back() {
  local edited="$1" staged
  kirinuki_output_ok "$edited" || return 1
  if [[ $fmt == png ]]; then
    cat -- "$edited" >"/dev/fd/$fd" || return 1
  else
    staged="$tmpdir/$base.fold.jpg"
    kirinuki_magick "png:$edited" -background white -flatten -quality "$QUALITY" \
      "jpg:$staged" 2>/dev/null && kirinuki_output_ok "$staged" || return 1
    cat -- "$staged" >"/dev/fd/$fd" || return 1
  fi
  # "Saved" would be a lie: the capture is still staged, and only Save in the
  # preview promotes it into the screenshots folder.
  omarchy-notification-send "Edit applied" "$(basename "$file")" -t 2000 \
    --image "$edited" >/dev/null 2>&1 || true
}

# %y carries nanoseconds, so two saves in the same second are still distinct.
current_stamp() { stat -c '%y %s' "$1" 2>/dev/null; }

# omasnap's editor (Omarchy 4.5+) writes its result into
# OMASNAP_SCREENSHOT_DIR rather than over the input, so point that at a private
# dir and fold back the newest file once the editor exits. If it saved nothing
# but rewrote the input instead, fold that.
if [[ $EDITOR_CMD == omasnap ]]; then
  outdir="$tmpdir/out"
  mkdir -p "$outdir" || exit 1
  before=$(current_stamp "$src")
  OMASNAP_SCREENSHOT_DIR="$outdir" omasnap --file "$src" --editor window >/dev/null 2>&1
  edited=$(find "$outdir" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
  if [[ -z $edited && $(current_stamp "$src") != "$before" ]]; then edited=$src; fi
  if [[ -n $edited ]] && fold_back "$edited"; then
    "$here/summon" "$file"
  fi
  exit 0
fi

# A custom editor edits the scratch copy in place; fold once it exits.
if [[ $EDITOR_CMD != tensaku-edit ]]; then
  before=$(current_stamp "$src")
  "$EDITOR_CMD" "$src"
  after=$(current_stamp "$src")
  if [[ -n $after && $after != "$before" ]] && fold_back "$src"; then
    "$here/summon" "$file"
  fi
  exit 0
fi

tensaku \
  --filename "$src" \
  --output-filename "$png" \
  --actions-on-enter save-to-clipboard \
  --save-after-copy \
  --copy-command "$self --copy-helper" \
  --disable-notifications &
tensaku_pid=$!

stamp=""
while kill -0 "$tensaku_pid" 2>/dev/null; do
  if [[ -s $png ]]; then
    cur=$(current_stamp "$png")
    if [[ -n $cur && $cur != "$stamp" ]]; then
      fold_back "$png" && stamp=$cur
    fi
  fi
  sleep 0.4
done

wait "$tensaku_pid"

# A save landing in the same instant Tensaku exits would miss the loop.
if [[ -s $png ]]; then
  cur=$(current_stamp "$png")
  if [[ -n $cur && $cur != "$stamp" ]]; then
    fold_back "$png" && stamp=$cur
  fi
fi

[[ -n $stamp ]] && "$here/summon" "$file"

exit 0
